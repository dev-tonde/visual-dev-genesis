# GitHub projects section (optional — username defaults to dev-tonde in src/lib/github.ts;
# a token raises the GitHub API rate limit)
VITE_GITHUB_USERNAME=your-github-username
VITE_GITHUB_TOKEN=

# Contact form (server-side only — set these in Vercel project settings, NOT as VITE_ vars).
# Used by api/contact.ts. If missing, the contact form fails gracefully; the site still renders.
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL=you@example.com
CONTACT_FROM="Portfolio <contact@your-verified-domain>"

# Optional cross-instance rate limiting for the contact endpoint (api/contact.ts).
# Without these, rate limiting still runs but is per-serverless-instance (best effort).
# Free tier at upstash.com is more than sufficient. Server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional extra allowed origins for the contact endpoint (comma-separated).
# Production domains and *.vercel.app previews are always allowed.
CONTACT_ALLOWED_ORIGINS=
